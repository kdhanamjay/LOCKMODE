# GEMINI_API_KEY: Optional AI assistant/policy analysis integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EduGuard MDM Enterprise Configuration
DATABASE_URL="postgresql://eduguard_user:eduguard_pass@localhost:5432/eduguard_mdm"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="eduguard-super-secret-jwt-key-for-enterprise-mdm"
JWT_EXPIRES_IN="8h"
FCM_PROJECT_ID="eduguard-mdm-prod"
FCM_SERVER_KEY="firebase-cloud-messaging-server-key"
STORAGE_BUCKET="eduguard-apk-deployments"
ENROLLMENT_TOKEN_SECRET="eduguard-enrollment-hmac-secret-v1"
ADMIN_SESSION_TIMEOUT_MINUTES="60"
LOG_LEVEL="info"
